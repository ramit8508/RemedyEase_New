# Production Environment Variables for RemedyEase Vercel Deployment

# Doctor Backend URL (Render persistent deployment)
VITE_DOCTOR_BACKEND_URL=https://remedyease-new-doctor.onrender.com

# User Backend URL (Render deployment)
VITE_USER_BACKEND_URL=https://remedyease-new-user.onrender.com

# Real-time WebSocket / Socket.io Server (Hosts persistent WebSockets for WebRTC signaling & Live Chat)
VITE_SOCKET_URL=https://remedyease-new-doctor.onrender.com
