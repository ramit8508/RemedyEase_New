# Environment variables for RemedyEase Frontend (Development)

# Backend URLs (for Vite proxy in development)
VITE_USER_BACKEND_URL=http://localhost:8000
VITE_DOCTOR_BACKEND_URL=http://localhost:5001

# Real-time WebSocket / Socket.io Server (Optional, defaults to VITE_DOCTOR_BACKEND_URL)
VITE_SOCKET_URL=http://localhost:5001